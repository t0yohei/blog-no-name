---
import { parseDate, parseDescription, type Post } from '../model';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import QiitaIcon from '../icons/qiita.png';

export interface Props {
  post: Post;
  headingLevel?: 3 | 4;
  variant?: 'card' | 'compact';
}

const { post, headingLevel = 3, variant = 'card' } = Astro.props;
const compact = variant === 'compact';
const Heading = headingLevel === 4 ? 'h4' : 'h3';
const sourceName = {
  blogs: 'Blog',
  slides: 'Speaker Deck',
  slidev: 'Slidev',
  qiitas: 'Qiita',
  zenns: 'Zenn',
  devTos: 'dev.to',
}[post.collection];

const getPostHref = (): string => {
  return post.collection === 'blogs' ? `blogs/${post.id}` : (post.data.url ?? '');
};

const getLinkAttributes = () => {
  const isExternalLink = post.collection !== 'blogs';
  return {
    href: getPostHref(),
    target: isExternalLink ? '_blank' : undefined,
    rel: isExternalLink ? 'noopener noreferrer' : undefined,
  };
};
---

<li class:list={['link-card', { compact }]}>
  <a {...getLinkAttributes()}>
    <div class="card-meta">
      <span class="icon-container">
        {post.collection === 'slides' && <Icon class="icon" name="speakerdeck" aria-hidden="true" />}
        {post.collection === 'slidev' && <Icon class="icon" name="mdi:presentation" aria-hidden="true" />}
        {post.collection === 'qiitas' && <Image src={QiitaIcon} alt="" class="icon" />}
        {post.collection === 'zenns' && <Icon class="icon" name="zenn" aria-hidden="true" />}
        {post.collection === 'devTos' && <Icon class="icon" name="devTo" aria-hidden="true" />}
        {!['slides', 'slidev', 'qiitas', 'zenns', 'devTos'].includes(post.collection) && (
          <Icon size={20} class="icon" name="mdi:file-document" aria-hidden="true" />
        )}
        <span class="source-label">{sourceName}</span>
      </span>
      <span class="link-icon-container">
        {post.collection === 'blogs' ? (
          <Icon class="icon" name="mdi:arrow-right" />
        ) : (
          <Icon class="icon" name="mdi:external-link" />
        )}
      </span>
    </div>
    <Heading class="card-title">{post.data.title}</Heading>
    {!compact && <p class="blog-body">{parseDescription(post)}</p>}
    <p class="pub-date">{parseDate(post)?.toISOString().slice(0, 10)}</p>
  </a>
</li>
<style>
  .link-card {
    list-style: none;
    display: flex;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    position: relative;
  }

  .link-card > a {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    min-height: 310px;
    padding: 24px;
    text-decoration: none;
    line-height: 1.75;
    border-radius: inherit;
    color: var(--text);
    background-color: var(--surface);
  }
  .card-title {
    margin: 18px 0 12px;
    font-size: 1.1875rem;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  .link-card:not(.compact) .card-title {
    text-wrap: pretty;
  }

  p {
    margin: 0;
    color: var(--text-muted);
  }

  .blog-body {
    font-size: 0.8125rem;
    line-height: 1.9;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .icon-container,
  .link-icon-container {
    display: inline-flex;
    align-items: center;
  }

  .pub-date {
    margin-top: auto;
    align-self: flex-start;
    padding-top: 22px;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .icon-container {
    gap: 8px;
  }

  .icon-container .icon {
    width: 20px;
    height: 20px;
  }

  .source-label {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .link-card > a:is(:hover, :focus-visible) {
    background-color: var(--surface-hover);
  }

  .icon {
    width: 17px;
    height: 17px;
    padding: 0;
    margin: 0;
  }

  .link-card:is(:hover, :focus-within) .card-title {
    color: rgb(var(--accent));
  }

  .link-card.compact {
    display: block;
    background: none;
    border: 0;
    border-radius: 0;
  }

  .compact + .compact {
    border-top: 1px solid var(--border);
  }

  .compact > a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) 8rem;
    grid-template-areas: 'date title meta';
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 12px 4px;
    background: transparent;
  }

  .compact > a:is(:hover, :focus-visible) {
    background-color: var(--surface-hover);
  }

  .compact .card-title {
    grid-area: title;
    margin: 0;
    padding: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .compact .pub-date {
    grid-area: date;
    margin: 0;
    padding-top: 0;
    align-self: center;
    justify-self: start;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .compact .card-meta {
    grid-area: meta;
    justify-self: end;
    gap: 8px;
  }

  .compact .icon-container .icon {
    display: none;
  }

  @media (max-width: 650px) {
    .link-card:not(.compact) > a {
      min-height: 0;
    }

    .link-card:not(.compact) .card-title {
      margin-top: 14px;
    }

    .blog-body {
      -webkit-line-clamp: 2;
    }

    .link-card:not(.compact) .pub-date {
      padding-top: 16px;
    }
  }

  @media (max-width: 639px) {
    .compact > a {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'title title' 'date meta';
      gap: 8px 12px;
    }
  }
</style>
