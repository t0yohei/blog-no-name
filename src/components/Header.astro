---
import { Icon } from 'astro-icon/components';
---

<header>
  <a href="/">Blog</a>
  <a href="/about">About</a>
  <a href="/app">App</a>
  <a href="https://github.com/t0yohei/Curriculum-Vitae" target="_blank" rel="noopener noopener">Job</a>
  <div class="theme-control" data-theme-control hidden>
    <button
      class="theme-trigger"
      type="button"
      data-theme-trigger
      aria-label="テーマを選択"
      title="テーマを選択"
      aria-haspopup="menu"
      aria-controls="theme-menu"
      aria-expanded="false"
    >
      <span data-theme-icon="light" aria-hidden="true"><Icon name="mdi:white-balance-sunny" size={22} /></span>
      <span data-theme-icon="dark" aria-hidden="true" hidden><Icon name="mdi:moon-waning-crescent" size={22} /></span>
    </button>
    <div class="theme-menu" id="theme-menu" data-theme-menu role="menu" aria-label="表示テーマ" hidden>
      {[
        { value: 'system', label: 'System', icon: 'mdi:monitor' },
        { value: 'light', label: 'Light', icon: 'mdi:white-balance-sunny' },
        { value: 'dark', label: 'Dark', icon: 'mdi:moon-waning-crescent' },
      ].map(({ value, label, icon }) => (
        <button type="button" role="menuitemradio" aria-checked={value === 'system' ? 'true' : 'false'} data-theme-option={value} tabindex="-1">
          <Icon name={icon} size={18} aria-hidden="true" />
          <span>{label}</span>
          <Icon class="check" name="mdi:check" size={18} aria-hidden="true" />
        </button>
      ))}
    </div>
  </div>
</header>
<style>
  header {
    padding: 10px 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    border-bottom: solid 2px;
    font-size: 1.3em;
  }

  .theme-control {
    position: relative;
    margin-left: auto;
    flex-shrink: 0;
    font-size: 14px;
  }

  [hidden] {
    display: none;
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .theme-trigger {
    width: 44px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
  }

  .theme-trigger span {
    line-height: 0;
  }

  .theme-menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    min-width: 148px;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }

  .theme-menu button {
    width: 100%;
    padding: 8px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    text-align: left;
  }

  .theme-menu button span {
    flex: 1;
  }

  button:hover,
  .theme-menu button:focus-visible {
    background: var(--surface-hover);
  }

  .check {
    visibility: hidden;
  }

  [aria-checked='true'] .check {
    visibility: visible;
  }

  @media (max-width: 479px) {
    header {
      padding-inline: 12px;
      gap: 12px;
    }
  }
</style>
