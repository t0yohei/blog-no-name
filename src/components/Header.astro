---
import { Icon } from 'astro-icon/components';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const blogCurrent = pathname === '/' ? 'page' : pathname.startsWith('/blogs/') ? 'location' : undefined;
---

<header>
  <a class="site-name" href="/">
    Blog No Name
  </a>
  <nav aria-label="メインナビゲーション">
    <a href="/" aria-current={blogCurrent}>
      Blog
    </a>
    <a href="/about" aria-current={pathname === '/about' ? 'page' : undefined}>
      About
    </a>
    <a href="/app" aria-current={pathname === '/app' ? 'page' : undefined}>
      App
    </a>
    <a href="https://github.com/t0yohei/Curriculum-Vitae" target="_blank" rel="noopener noreferrer">
      Job
    </a>
  </nav>
  <div class="theme-control" data-theme-control hidden>
    <button
      class="theme-trigger"
      type="button"
      data-theme-trigger
      aria-label="テーマを選択"
      title="テーマを選択"
      aria-haspopup="menu"
      aria-controls="theme-menu"
      aria-expanded="false"
    >
      <span data-theme-icon="light" aria-hidden="true">
        <Icon name="mdi:white-balance-sunny" size={22} />
      </span>
      <span data-theme-icon="dark" aria-hidden="true" hidden>
        <Icon name="mdi:moon-waning-crescent" size={22} />
      </span>
    </button>
    <div class="theme-menu" id="theme-menu" data-theme-menu role="menu" aria-label="表示テーマ" hidden>
      {[
        { value: 'system', label: 'System', icon: 'mdi:monitor' },
        { value: 'light', label: 'Light', icon: 'mdi:white-balance-sunny' },
        { value: 'dark', label: 'Dark', icon: 'mdi:moon-waning-crescent' },
      ].map(({ value, label, icon }) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked={value === 'system' ? 'true' : 'false'}
          data-theme-option={value}
          tabindex="-1"
        >
          <Icon name={icon} size={18} aria-hidden="true" />
          <span>{label}</span>
          <Icon class="check" name="mdi:check" size={18} aria-hidden="true" />
        </button>
      ))}
    </div>
  </div>
</header>
<style>
  header {
    max-width: 120ch;
    margin: 0 auto;
    padding: 16px 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }

  .site-name,
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }

  .site-name:visited,
  nav a:visited {
    color: var(--text);
  }

  .site-name {
    width: fit-content;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  nav {
    display: flex;
    gap: 8px;
  }

  nav a {
    padding: 8px;
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-underline-offset: 0.5em;
    text-decoration-thickness: 2px;
  }

  nav a:visited {
    color: var(--text-muted);
  }

  nav a[aria-current] {
    color: var(--text);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: rgb(var(--accent));
  }

  nav a:hover {
    color: var(--text);
    text-decoration-line: underline;
  }

  .theme-control {
    position: relative;
    justify-self: end;
    flex-shrink: 0;
    font-size: 14px;
  }

  [hidden] {
    display: none;
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .theme-trigger {
    width: 44px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
  }

  .theme-trigger span {
    line-height: 0;
  }

  .theme-menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    min-width: 148px;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }

  .theme-menu button {
    width: 100%;
    padding: 8px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    text-align: left;
  }

  .theme-menu button span {
    flex: 1;
  }

  button:hover,
  .theme-menu button:focus-visible {
    background: var(--surface-hover);
  }

  .check {
    visibility: hidden;
  }

  [aria-checked='true'] .check {
    visibility: visible;
  }

  @media (max-width: 767px) {
    header {
      grid-template-columns: minmax(0, 1fr) auto;
      max-width: 80ch;
      padding: 12px 20px;
      gap: 4px 12px;
    }

    .site-name {
      grid-column: 1 / -1;
    }

    nav {
      gap: 4px;
    }

    nav a {
      padding-inline: 6px;
    }
  }

  @media (max-width: 479px) {
    header {
      max-width: 60ch;
    }
  }
</style>
