---
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ArticleShare from '../components/ArticleShare.astro';
import ArticleLike from '../components/ArticleLike.astro';
import '../styles/global.css';
import { ClientRouter, slide } from 'astro:transitions';
import type { CollectionEntry } from 'astro:content';
import { parseDescription } from '../model';
import { Icon } from 'astro-icon/components';

type Props = {
  entry: CollectionEntry<'blogs'>;
  previousEntry?: CollectionEntry<'blogs'>;
  nextEntry?: CollectionEntry<'blogs'>;
};
const { entry, previousEntry, nextEntry } = Astro.props;

const preview = parseDescription(entry);
const pageUrl = new URL(`/blogs/${entry.id}`, Astro.site);
const imageUrl = new URL(`/og/${entry.id}.png`, Astro.site).href;
const authorName = 'とよへい(t0yohei)';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: preview,
  datePublished: entry.data.pubdate.toISOString(),
  url: pageUrl.href,
  mainEntityOfPage: pageUrl.href,
  image: imageUrl,
  author: {
    '@type': 'Person',
    name: authorName,
    url: new URL('/about', Astro.site).href,
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={preview} />
    <link rel="canonical" href={pageUrl.href} />
    <meta property="og:site_name" content="Blog No Name" />
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={entry.data.title} />
    <meta property="og:description" content={preview} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@t0yohei" />
    <title>{entry.data.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <nav class="article-back-nav" aria-label="記事一覧">
      <a href="/">
        <Icon name="mdi:arrow-left" size={16} aria-hidden="true" />
        記事一覧へ
      </a>
    </nav>
    <main transition:animate={slide({ duration: '0.5s' })}>
      <header class="article-heading">
        <p class="article-meta">
          <span>Blog</span>
          <time datetime={entry.data.pubdate.toISOString()}>{entry.data.pubdate.toISOString().slice(0, 10)}</time>
        </p>
        <h1>{entry.data.title}</h1>
        <p class="article-description">{preview}</p>
      </header>
      <slot />
      <footer>
        <ArticleLike articleId={entry.id} />
        <ArticleShare title={entry.data.title} url={pageUrl.href} />
        {(previousEntry || nextEntry) && (
          <nav class="article-navigation" aria-label="前後の記事">
            {nextEntry && (
              <a class="article-link next" href={`/blogs/${nextEntry.id}`} rel="next">
                <span class="direction">
                  <Icon name="mdi:arrow-left" size={20} aria-hidden="true" />
                  次の記事
                </span>
                <strong class="article-title">{nextEntry.data.title}</strong>
                <time datetime={nextEntry.data.pubdate.toISOString()}>
                  {nextEntry.data.pubdate.toISOString().slice(0, 10)}
                </time>
              </a>
            )}
            {previousEntry && (
              <a class="article-link previous" href={`/blogs/${previousEntry.id}`} rel="prev">
                <span class="direction">
                  前の記事
                  <Icon name="mdi:arrow-right" size={20} aria-hidden="true" />
                </span>
                <strong class="article-title">{previousEntry.data.title}</strong>
                <time datetime={previousEntry.data.pubdate.toISOString()}>
                  {previousEntry.data.pubdate.toISOString().slice(0, 10)}
                </time>
              </a>
            )}
          </nav>
        )}
        <a class="back-to-index" href="/">
          ブログ一覧に戻る
        </a>
      </footer>
    </main>
    <script>
      let codeObserver: ResizeObserver | undefined;

      function setupCodeScrolling() {
        codeObserver?.disconnect();
        codeObserver = new ResizeObserver((entries) => {
          for (const { target } of entries) {
            const block = target as HTMLPreElement;
            const hint = block.previousElementSibling as HTMLParagraphElement;
            const scrollable = block.scrollWidth > block.clientWidth;
            hint.hidden = !scrollable;
            if (scrollable) {
              block.tabIndex = 0;
              block.setAttribute('role', 'region');
              block.setAttribute('aria-label', 'コード（左右にスクロールできます）');
            } else {
              block.removeAttribute('tabindex');
              block.removeAttribute('role');
              block.removeAttribute('aria-label');
            }
          }
        });

        for (const block of document.querySelectorAll<HTMLPreElement>('main pre')) {
          if (!block.previousElementSibling?.classList.contains('code-scroll-hint')) {
            const hint = document.createElement('p');
            hint.className = 'code-scroll-hint';
            hint.textContent = '左右にスクロールできます';
            hint.hidden = true;
            block.before(hint);
          }
          codeObserver.observe(block);
        }
      }

      document.addEventListener('astro:page-load', setupCodeScrolling);
      document.addEventListener('astro:before-swap', () => codeObserver?.disconnect());
    </script>
    <style>
      main {
        width: calc(100% - 112px);
        max-width: 860px;
        padding: 42px 52px;
        line-height: 2.15;
        background-color: var(--surface);
        border-radius: 16px;
      }

      .article-back-nav {
        width: calc(100% - 112px);
        max-width: 860px;
        margin: 30px auto 34px;
      }

      .article-back-nav a {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        font-size: 0.75rem;
        text-decoration: none;
      }

      .article-heading {
        margin-bottom: 40px;
        padding-bottom: 34px;
        border-bottom: 1px solid var(--border);
      }

      .article-meta {
        display: flex;
        gap: 16px;
        align-items: center;
        margin: 0 0 22px;
        color: var(--text-muted);
        font-size: 0.75rem;
      }

      .article-meta span {
        color: var(--link);
      }

      .article-description {
        margin: 24px 0 0;
        color: var(--text-muted);
        font-size: 0.9375rem;
        line-height: 2;
      }

      main > :global(p) {
        margin-block: 0 25px;
      }

      h1 {
        font-size: 31px;
        letter-spacing: -0.025em;
        overflow-wrap: anywhere;
        text-wrap: balance;
        word-break: auto-phrase;
        line-height: 1.75;
      }

      main > :global(h2),
      main > :global(h3) {
        margin-block: 54px 20px;
        line-height: 1.7;
        text-wrap: balance;
      }

      main :global(ul),
      main :global(ol) {
        padding-inline-start: 1.5em;
      }

      main :global(blockquote) {
        margin-inline: 0;
        padding: 0.75em 1em;
        border-inline-start: 1px solid var(--border-strong);
        background-color: var(--surface-hover);
      }

      main :global(blockquote > :first-child) {
        margin-top: 0;
      }

      main :global(blockquote > :last-child) {
        margin-bottom: 0;
      }

      main :global(pre) {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 6px;
        scrollbar-color: var(--border-strong) var(--surface-hover);
      }

      main :global(pre code) {
        width: max-content;
      }

      main :global(.code-scroll-hint) {
        margin: 1rem 0 0.375rem;
        color: var(--text-muted);
        font-size: 0.8125rem;
        line-height: 1.5;
        text-align: right;
      }

      main :global(.code-scroll-hint:not([hidden]) + pre) {
        margin-top: 0;
      }

      footer {
        margin-top: 64px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }

      .article-navigation {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
      }

      .article-link {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 20px 16px;
        border-radius: 8px;
        color: var(--text);
        text-decoration: none;
      }

      .previous {
        grid-column: 2;
        align-items: flex-end;
        text-align: right;
      }

      .direction {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .article-title {
        margin: 8px 0;
        font-size: 1.125rem;
        line-height: 1.65;
        overflow-wrap: anywhere;
        text-wrap: balance;
        text-decoration: underline;
        text-decoration-color: var(--underline);
        text-underline-offset: 0.2em;
      }

      time {
        color: var(--text-muted);
        font-size: 0.8125rem;
        font-variant-numeric: tabular-nums;
      }

      .article-link time {
        margin-top: auto;
      }

      .article-link:is(:hover, :focus-visible) {
        background-color: var(--surface-hover);
      }

      .article-link:is(:hover, :focus-visible) .article-title {
        color: var(--link);
        text-decoration-color: currentColor;
      }

      .back-to-index {
        display: block;
        width: fit-content;
        margin: 32px auto 0;
        padding: 10px;
        color: var(--text-muted);
        font-size: 0.875rem;
        text-underline-offset: 0.2em;
      }

      footer a:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 4px;
      }

      @media (max-width: 650px) {
        main {
          width: 100%;
          padding: 0 24px 40px;
          background-color: transparent;
          border-radius: 0;
          font-size: 0.9375rem;
          line-height: 2.1;
        }

        .article-back-nav {
          width: 100%;
          margin: 22px auto 26px;
          padding-inline: 24px;
        }

        .article-heading {
          margin-bottom: 30px;
          padding-bottom: 26px;
        }

        .article-meta {
          margin-bottom: 18px;
        }

        .article-description {
          font-size: 0.875rem;
        }

        h1 {
          font-size: 26px;
          line-height: 1.85;
        }

        main > :global(h2),
        main > :global(h3) {
          margin-top: 42px;
        }

        .article-navigation {
          grid-template-columns: minmax(0, 1fr);
          gap: 8px;
        }

        .previous {
          grid-column: 1;
          align-items: flex-start;
          text-align: left;
        }

        .next + .previous {
          border-top: 1px solid var(--border);
        }
      }
    </style>
  </body>
</html>
