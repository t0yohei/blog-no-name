---
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ArticleShare from '../components/ArticleShare.astro';
import '../styles/global.css';
import { ClientRouter, slide } from 'astro:transitions';
import type { CollectionEntry } from 'astro:content';
import { parseDescription } from '../model';
import { Icon } from 'astro-icon/components';

type Props = {
  entry: CollectionEntry<'blogs'>;
  previousEntry?: CollectionEntry<'blogs'>;
  nextEntry?: CollectionEntry<'blogs'>;
};
const { entry, previousEntry, nextEntry } = Astro.props;

const preview = parseDescription(entry);
const pageUrl = new URL(`/blogs/${entry.id}`, Astro.site);
const imageUrl = new URL(`/og/${entry.id}.png`, Astro.site).href;
const authorName = 'とよへい(t0yohei)';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: preview,
  datePublished: entry.data.pubdate.toISOString(),
  url: pageUrl.href,
  mainEntityOfPage: pageUrl.href,
  image: imageUrl,
  author: {
    '@type': 'Person',
    name: authorName,
    url: new URL('/about', Astro.site).href,
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={preview} />
    <link rel="canonical" href={pageUrl.href} />
    <meta property="og:site_name" content="Blog No Name" />
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={entry.data.title} />
    <meta property="og:description" content={preview} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@t0yohei" />
    <title>{entry.data.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main transition:animate={slide({ duration: '0.5s' })}>
      <h1>{entry.data.title}</h1>
      <p>投稿日: {entry.data.pubdate.toISOString().slice(0, 10)}</p>
      <slot />
      <footer>
        <ArticleShare title={entry.data.title} url={pageUrl.href} />
        {(previousEntry || nextEntry) && (
          <nav class="article-navigation" aria-label="前後の記事">
            {nextEntry && (
              <a class="article-link next" href={`/blogs/${nextEntry.id}`} rel="next">
                <span class="direction">
                  <Icon name="mdi:arrow-left" size={20} aria-hidden="true" />
                  次の記事
                </span>
                <strong class="article-title">{nextEntry.data.title}</strong>
                <time datetime={nextEntry.data.pubdate.toISOString()}>
                  {nextEntry.data.pubdate.toISOString().slice(0, 10)}
                </time>
              </a>
            )}
            {previousEntry && (
              <a class="article-link previous" href={`/blogs/${previousEntry.id}`} rel="prev">
                <span class="direction">
                  前の記事
                  <Icon name="mdi:arrow-right" size={20} aria-hidden="true" />
                </span>
                <strong class="article-title">{previousEntry.data.title}</strong>
                <time datetime={previousEntry.data.pubdate.toISOString()}>
                  {previousEntry.data.pubdate.toISOString().slice(0, 10)}
                </time>
              </a>
            )}
          </nav>
        )}
        <a class="back-to-index" href="/">
          ブログ一覧に戻る
        </a>
      </footer>
    </main>
    <style>
      main {
        max-width: 52rem;
        background-color: var(--surface);
        margin-top: 40px;
        border-radius: 8px;
      }

      h1 {
        font-size: 32px;
        overflow-wrap: anywhere;
        text-wrap: balance;
        line-height: 1.4;
      }

      main > :global(h2),
      main > :global(h3) {
        margin-block: 2rem 0.75rem;
        line-height: 1.4;
        text-wrap: balance;
      }

      main :global(ul),
      main :global(ol) {
        padding-inline-start: 1.5em;
      }

      main :global(blockquote) {
        margin-inline: 0;
        padding: 0.75em 1em;
        border-inline-start: 1px solid var(--border-strong);
        background-color: var(--surface-hover);
      }

      main :global(blockquote > :first-child) {
        margin-top: 0;
      }

      main :global(blockquote > :last-child) {
        margin-bottom: 0;
      }

      p {
        color: var(--text-muted);
        text-align: right;
      }

      footer {
        margin-top: 64px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }

      .article-navigation {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
      }

      .article-link {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 20px 16px;
        border-radius: 8px;
        color: var(--text);
        text-decoration: none;
      }

      .previous {
        grid-column: 2;
        align-items: flex-end;
        text-align: right;
      }

      .direction {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .article-title {
        margin: 8px 0;
        font-size: 1.125rem;
        line-height: 1.65;
        overflow-wrap: anywhere;
        text-wrap: balance;
        text-decoration: underline;
        text-decoration-color: var(--underline);
        text-underline-offset: 0.2em;
      }

      time {
        margin-top: auto;
        color: var(--text-muted);
        font-size: 0.8125rem;
      }

      .article-link:is(:hover, :focus-visible) {
        background-color: var(--surface-hover);
      }

      .article-link:is(:hover, :focus-visible) .article-title {
        color: var(--link);
        text-decoration-color: currentColor;
      }

      .back-to-index {
        display: block;
        width: fit-content;
        margin: 32px auto 0;
        padding: 10px;
        color: var(--text-muted);
        font-size: 0.875rem;
        text-underline-offset: 0.2em;
      }

      footer a:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 4px;
      }

      @media (max-width: 639px) {
        h1 {
          font-size: clamp(1.5rem, 7vw, 1.75rem);
        }

        .article-navigation {
          grid-template-columns: minmax(0, 1fr);
          gap: 8px;
        }

        .previous {
          grid-column: 1;
          align-items: flex-start;
          text-align: left;
        }

        .next + .previous {
          border-top: 1px solid var(--border);
        }
      }
    </style>
  </body>
</html>
