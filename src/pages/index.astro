---
// export const prerender = false;
import HomeLayout from '../layouts/HomeLayout.astro';
import Card from '../components/Card.astro';
import '../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import { parseDate, type Post } from '../model';

const buildPosts = async (): Promise<Post[]> => {
  const getAllPosts = async (): Promise<Post[]> => {
    const blogs: CollectionEntry<'blogs'>[] = await getCollection('blogs');
    const slides: CollectionEntry<'slides'>[] = await getCollection('slides');
    const qiitas: CollectionEntry<'qiitas'>[] = await getCollection('qiitas');
    const zenns: CollectionEntry<'zenns'>[] = await getCollection('zenns');
    const devTos: CollectionEntry<'devTos'>[] = await getCollection('devTos');
    return [...blogs, ...slides, ...qiitas, ...zenns, ...devTos];
  };

  const sortPostsByDate = (posts: Post[]) => {
    return posts.sort((a, b) => {
      const aDate = parseDate(a);
      const bDate = parseDate(b);
      return (bDate?.getTime() ?? 0) - (aDate?.getTime() ?? 0);
    });
  };

  return sortPostsByDate(await getAllPosts());
};

const posts = await buildPosts();
const recentPosts = posts.slice(0, 6);
const postsByYear = new Map<string, Post[]>();
for (const post of posts) {
  const year = parseDate(post)?.getUTCFullYear().toString() ?? 'unknown';
  const entries = postsByYear.get(year) ?? [];
  entries.push(post);
  postsByYear.set(year, entries);
}
const yearLabel = (year: string) => (year === 'unknown' ? '公開年不明' : `${year}年`);
---

<HomeLayout title="Blog No Name">
  <main>
    <h1 class="visually-hidden">Blog No Name</h1>
    <section aria-labelledby="recent-heading" class="recent-posts">
      <div class="section-heading">
        <h2 id="recent-heading">最近の記事</h2>
        <a href="#archive-heading">年別アーカイブへ</a>
      </div>
      <ul role="list" class="link-card-grid">
        {recentPosts.map((post) => (
          <Card post={post} />
        ))}
      </ul>
    </section>
    <section aria-labelledby="archive-heading" class="article-archive">
      <h2 id="archive-heading">年別アーカイブ</h2>
      <nav aria-label="公開年から探す" class="year-links">
        {[...postsByYear.keys()].map((year) => (
          <a href={`#year-${year}`}>{yearLabel(year)}</a>
        ))}
      </nav>
      {[...postsByYear].map(([year, entries]) => (
        <section aria-labelledby={`year-${year}`} class="archive-year">
          <h3 id={`year-${year}`}>{yearLabel(year)}</h3>
          <ul role="list" class="archive-list">
            {entries.map((post) => (
              <Card post={post} headingLevel={4} variant="compact" />
            ))}
          </ul>
        </section>
      ))}
    </section>
  </main>
</HomeLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 24px 0 16px;
  }
  h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .section-heading a {
    padding: 8px 0;
    font-size: 0.875rem;
    text-underline-offset: 0.2em;
  }
  .article-archive {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .year-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 16px 0 24px;
  }
  .year-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 4px;
    text-underline-offset: 0.2em;
  }
  .archive-year + .archive-year {
    margin-top: 40px;
  }
  .archive-year h3 {
    margin: 0 0 16px;
    font-size: 1.25rem;
  }
  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .instructions {
    line-height: 1.6;
    margin: 1rem 0;
    border: 1px solid rgba(var(--accent), 25%);
    background-color: var(--surface);
    padding: 1rem;
    border-radius: 0.4rem;
  }
  .instructions code {
    font-size: 0.875em;
    font-weight: bold;
    background: rgba(var(--accent), 12%);
    color: rgb(var(--accent));
    border-radius: 4px;
    padding: 0.3em 0.45em;
  }
  .instructions strong {
    color: rgb(var(--accent));
  }
  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 335px), 1fr));
    gap: 1.5rem;
    padding: 0;
    margin: 0;
  }
</style>
