---
import MarkdownBlogLayout from '../../layouts/MarkdownBlogLayout.astro';
import { getCollection, render } from 'astro:content';

// 1. Get the id from the incoming server request
const { id } = Astro.params;
if (id === undefined) return Astro.rewrite('/404');

// 2. Find the article and its neighbors by publication date
const entries = (await getCollection('blogs')).sort(
  (a, b) => a.data.pubdate.getTime() - b.data.pubdate.getTime() || a.id.localeCompare(b.id),
);
const entryIndex = entries.findIndex((entry) => entry.id === id);
if (entryIndex === -1) return Astro.rewrite('/404');
const entry = entries[entryIndex];
const previousEntry = entries[entryIndex - 1];
const nextEntry = entries[entryIndex + 1];

// 3. render the entry to HTML in the template
const { Content } = await render(entry);
---

<MarkdownBlogLayout entry={entry} previousEntry={previousEntry} nextEntry={nextEntry}>
  <Content />
</MarkdownBlogLayout>
